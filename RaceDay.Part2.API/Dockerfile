FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY RaceDay.Part2.csproj ./
RUN dotnet restore RaceDay.Part2.csproj
COPY . ./
RUN dotnet publish RaceDay.Part2.csproj -c Release -o /out
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /out ./
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet","RaceDay.Part2.dll"]
