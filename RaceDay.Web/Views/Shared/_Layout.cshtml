<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>RaceDay | Run your race</title><link rel="stylesheet" href="~/css/site.css" /></head><body><header><a class="brand" asp-action="Index">RACE<span>DAY</span></a><nav><a asp-action="Index">Discover</a><a asp-action="Dashboard">Dashboard</a><a asp-action="Profile">Profile</a>@if(Context.Session.GetString("Role")==null){<a asp-action="Login">Log in</a><a class="btn small" asp-action="Register">Join RaceDay</a>}else{<span>Hi, @Context.Session.GetString("Name")</span><form asp-action="Logout" method="post"><button class="link">Log out</button></form>}</nav></header><main>@if(TempData["Message"]!=null){<div class="notice">@TempData["Message"]</div>}@RenderBody()</main><footer>RaceDay · Race management made simple · Part 3 MVC</footer></body></html>