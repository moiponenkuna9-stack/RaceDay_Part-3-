<div class="account-grid"><section class="panel"><h2>Welcome back</h2><p>Sign in to manage your races.</p><form asp-action="Login" method="post"><label>Email<input type="email" name="email" required /></label><label>Password<input type="password" name="password" required /></label><button class="btn">Log in</button></form></section><section class="panel"><h2>Join RaceDay</h2><p>Create an organiser or participant account.</p><form asp-action="Register" method="post"><label>First name<input name="firstName" required /></label><label>Last name<input name="lastName" required /></label><label>Email<input type="email" name="email" required /></label><label>Password (8+ characters)<input type="password" name="password" minlength="8" required /></label><label>Phone<input name="phone" /></label><label>Account type<select name="role"><option>Participant</option><option>Organiser</option></select></label><button class="btn">Create account</button></form></section></div>