@model List<JsonElement>
<section class="hero"><p class="eyebrow">THE FINISH LINE STARTS HERE</p><h1>Find your next <em>great race.</em></h1><p>Explore events, register to compete, and celebrate every finish.</p><a class="btn" asp-action="Register">Get started</a></section><div class="section-heading"><h2>Upcoming races</h2><form method="get"><input name="search" placeholder="Search races by name"/><button>Search</button></form></div>@if(!string.IsNullOrWhiteSpace(ViewBag.Error)){<p class="notice">@ViewBag.Error</p>}<div class="cards">@foreach(var e in Model){<article class="card"><div class="card-banner">🏃 <span>RACE EVENT</span></div><div class="pad"><small>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</small><h3>@e.GetProperty("name").GetString()</h3><p>📍 @e.GetProperty("location").GetString()</p><p>@e.GetProperty("distanceKm") km · @e.GetProperty("eventType")</p><a class="btn" asp-action="Event" asp-route-id="@e.GetProperty("eventId").GetInt32()">View details</a></div></article>}</div>