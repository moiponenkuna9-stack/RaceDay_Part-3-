<div class="panel narrow"><h1>Create a race</h1><form asp-action="CreateEvent" method="post"><label>Race name<input name="name" required /></label><label>Description<textarea name="description"></textarea></label><label>Event date<input name="eventDate" type="datetime-local" required /></label><label>Location<input name="location" required /></label><label>Distance (km)<input name="distanceKm" type="number" min="0.1" max="500" step="0.1" required /></label><label>Event type<select name="eventType"><option value="0">Run</option><option value="1">Walk</option><option value="2">Cycle</option></select></label><label>Registration opens<input name="registrationOpen" type="datetime-local" required /></label><label>Registration closes<input name="registrationClose" type="datetime-local" required /></label><label>Status<select name="status"><option value="1">Open</option><option value="0">Draft</option></select></label><button class="btn">Create race</button></form></div>