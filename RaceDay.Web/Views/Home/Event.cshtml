@model JsonElement
@{var id=Model.GetProperty("eventId").GetInt32();}
<section class="detail-hero"><p class="eyebrow">RACE DETAILS</p><h1>@Model.GetProperty("name").GetString()</h1><p>@Model.GetProperty("description").ToString()</p><div class="stats"><span>📅 @Model.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</span><span>📍 @Model.GetProperty("location").GetString()</span><span>🏃 @Model.GetProperty("distanceKm") km</span></div></section><div class="panel"><h2>Race categories</h2><div class="cards">@foreach(var c in Model.GetProperty("categories").EnumerateArray()){<div class="card pad"><h3>@c.GetProperty("name").GetString()</h3><p>@c.GetProperty("distanceKm") km · Entry fee: @c.GetProperty("entryFee")</p>@if(ViewBag.Role=="Participant"){<form asp-action="Enrol" method="post"><input type="hidden" name="id" value="@id"/><input type="hidden" name="categoryId" value="@c.GetProperty("categoryId").GetInt32()"/><button class="btn">Enrol now</button></form>}</div>}</div></div><div class="panel"><h2>Race results</h2><div class="table-wrap"><table><tr><th>Participant</th><th>Position</th><th>Time</th><th>Status</th></tr>@foreach(JsonElement r in (List<JsonElement>)ViewBag.Results){<tr><td>@r.GetProperty("participantName").GetString()</td><td>@r.GetProperty("position")</td><td>@r.GetProperty("finishTime")</td><td>@r.GetProperty("resultStatus")</td></tr>}</table></div></div>@if(ViewBag.Role=="Organiser"){<div class="panel"><h2>Enrolments & publish results</h2>@foreach(JsonElement e in (List<JsonElement>)ViewBag.Enrolments){<div class="entry"><strong>@e.GetProperty("participantName").GetString()</strong> — @e.GetProperty("categoryName").GetString()<form asp-action="PublishResult" method="post"><input type="hidden" name="id" value="@id"/><input type="hidden" name="enrolmentId" value="@e.GetProperty("enrolmentId").GetInt32()"/><input name="finishTime" placeholder="01:25:30"/><input type="number" min="1" name="position" placeholder="Position"/><select name="resultStatus"><option value="0">Finished</option><option value="1">DNF</option><option value="2">DNS</option><option value="3">DSQ</option></select><button class="btn small">Publish result</button></form></div>}</div>}