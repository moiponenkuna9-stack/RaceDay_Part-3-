@model List<JsonElement>
<div class="section-heading"><div><p class="eyebrow">YOUR SPACE</p><h1>@ViewBag.Role Dashboard</h1></div>@if(ViewBag.Role=="Organiser"){<a class="btn" asp-action="CreateEvent">+ Create an event</a>}</div>@if(ViewBag.Role=="Participant"){<h2>My enrolments</h2><div class="cards">@foreach(JsonElement x in (List<JsonElement>)ViewBag.Enrolments){<div class="card pad"><h3>@x.GetProperty("eventName").GetString()</h3><p>@x.GetProperty("categoryName").GetString() · @x.GetProperty("status").GetString()</p><p>Race number: @x.GetProperty("raceNumber")</p><form asp-action="Cancel" method="post"><input type="hidden" name="enrolmentId" value="@x.GetProperty("enrolmentId").GetInt32()"/><button class="danger">Cancel enrolment</button></form></div>}</div>}<h2>All races</h2><div class="cards">@foreach(var x in Model){<div class="card pad"><small>@x.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</small><h3>@x.GetProperty("name").GetString()</h3><p>@x.GetProperty("location").GetString()</p><a class="btn" asp-action="Event" asp-route-id="@x.GetProperty("eventId").GetInt32()">Manage / View</a>@if(ViewBag.Role=="Organiser"){<form asp-action="DeleteEvent" method="post"><input type="hidden" name="id" value="@x.GetProperty("eventId").GetInt32()"/><button class="danger">Delete event</button></form>}</div>}</div>